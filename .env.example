# ─────────────────────────────────────────────────────────────────────────────
# helenawreford.com: content configuration
#
# Every value below is OPTIONAL. Anything you leave out falls back to the
# built-in content in content/defaults.ts, so a missing variable can never
# break the site.
#
# In Vercel: Project → Settings → Environment Variables. Add the ones you want
# to change, then redeploy (Deployments → ⋯ → Redeploy) for them to take effect.
#
# Format rules
#   |    separates the fields of one record
#   ||   separates paragraphs inside a long text field
#   ,    separates items in a list of image URLs
# Images can be a file in this repo (/images/puffin.jpg) or any https:// URL.
# ─────────────────────────────────────────────────────────────────────────────

# ── Identity ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME="Helena Wreford"
NEXT_PUBLIC_SITE_ROLE="Filmmaker & Zoologist"
NEXT_PUBLIC_SITE_TAGLINE="Wildlife storytelling for screen and print, by a zoologist behind the camera."
NEXT_PUBLIC_SITE_LOCATION="London, United Kingdom"
NEXT_PUBLIC_SITE_EMAIL="helenawreford@live.com"
NEXT_PUBLIC_SITE_URL="https://helenawreford.com"
NEXT_PUBLIC_SITE_AVAILABILITY="Available for commissions and crew work"

# ── Opening screen ──────────────────────────────────────────────────────────
# The headline is split into lines on "/", and each line animates in separately.
NEXT_PUBLIC_HERO_HEADLINE="Helena / Wreford"
NEXT_PUBLIC_HERO_IMAGE="/images/puffin.jpg"

# ── Social links (only the ones you set are shown) ──────────────────────────
NEXT_PUBLIC_SOCIAL_INSTAGRAM="https://www.instagram.com/helswreford/"
NEXT_PUBLIC_SOCIAL_LINKEDIN="https://www.linkedin.com/in/hels-wreford-2500971b1/"
# NEXT_PUBLIC_SOCIAL_VIMEO=""
# NEXT_PUBLIC_SOCIAL_YOUTUBE=""
# NEXT_PUBLIC_SOCIAL_IMDB=""

# ── About page ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_ABOUT_INTRO="I am a zoologist who tells stories with a camera."
NEXT_PUBLIC_ABOUT_BODY="First paragraph. || Second paragraph. || Third paragraph."
NEXT_PUBLIC_ABOUT_QUOTE="The goal is never the animal in frame."
NEXT_PUBLIC_ABOUT_PORTRAIT="/images/girls.jpg"
NEXT_PUBLIC_ABOUT_QUOTE_IMAGE="/images/monkey.jpg"

# ── Film & TV, up to 8 (NEXT_PUBLIC_FILM_1 … _8) ───────────────────────────
# Title | Role | Year | Format | Poster image | Link (optional) | Description
NEXT_PUBLIC_FILM_1="Bristol: A Hidden Eden | Drone Pilot · Researcher · Editor | 2022 | Documentary short | /images/puffin.jpg |  | A city read as an ecosystem."
# Extra stills for the project page (comma separated, optional):
NEXT_PUBLIC_FILM_1_STILLS="/images/volcano.jpg, /images/fish.jpg"
# The project narrative, paragraphs separated by || (optional):
NEXT_PUBLIC_FILM_1_BODY="First paragraph of the story. || Second paragraph."

# ── Showreel, the video under the hero on the home page ───────────────────
# Paste the ordinary YouTube or Vimeo link. Leave the URL empty to hide the
# section. Unlisted Vimeo links keep their /HASH suffix.
NEXT_PUBLIC_SHOWREEL_URL=""
NEXT_PUBLIC_SHOWREEL_TITLE="Showreel"
NEXT_PUBLIC_SHOWREEL_EYEBROW="Reel"
NEXT_PUBLIC_SHOWREEL_CAPTION="Selected wildlife and documentary work."
NEXT_PUBLIC_SHOWREEL_POSTER="/images/clown-fish.jpg"

# ── Photography, up to 30 (NEXT_PUBLIC_PHOTO_1 … _30) ─────────────────────
# Title | Location | Year | Image | Caption
NEXT_PUBLIC_PHOTO_1="Hanging In There | Philippines | 2023 | /images/butterfly.jpg | A Pipevine Swallowtail."
NEXT_PUBLIC_PHOTO_2="Spotted Something | Skomer Island, Wales | 2023 | /images/puffin.jpg | A puffin on the cliff edge."

# ── Capabilities, up to 8 ──────────────────────────────────────────────────
# Title | Description
NEXT_PUBLIC_CAPABILITY_1="Direction & Camera | Shooting on Sony A7 IV and VENICE 2."

# ── Path / timeline, up to 8 ───────────────────────────────────────────────
# Period | Title | Organisation | Detail
NEXT_PUBLIC_TIMELINE_1="2024 to present | Researcher | WildReach Productions | Pitching stories about people and wildlife."

# ── Recognition, up to 6 ───────────────────────────────────────────────────
# Title | Detail | Year
NEXT_PUBLIC_AWARD_1="Communicating Science Through Filmmaking | Winner, judged by BBC Planet Earth III producers | 2023"
